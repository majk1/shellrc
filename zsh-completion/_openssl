#compdef openssl
#
# zsh completion for openssl(1)  --  Ubuntu 24.04 / OpenSSL 3.x
#
# A parancsok es a kapcsolok listajat maga a telepitett openssl binaris adja
# ("openssl list -commands", illetve "openssl <parancs> -help"), igy verziofrissites
# utan is helyes marad.
#
# Telepites:
#   mkdir -p ~/.zsh/completions && cp _openssl ~/.zsh/completions/
#   .zshrc-be (a compinit hivas ELE):
#     fpath=(~/.zsh/completions $fpath)
#     autoload -Uz compinit && compinit
#   majd:  rm -f ~/.zcompdump*; exec zsh

_openssl_commands() {
  local ret=1
  local -a std dgst ciph

  std=(  ${=${(f)"$(_call_program openssl-commands openssl list -standard-commands 2>/dev/null)"}} )
  dgst=( ${=${(f)"$(_call_program openssl-commands openssl list -digest-commands   2>/dev/null)"}} )
  ciph=( ${=${(f)"$(_call_program openssl-commands openssl list -cipher-commands   2>/dev/null)"}} )

  (( $#std + $#dgst + $#ciph )) || \
    std=( ${=${(f)"$(_call_program openssl-commands openssl list -commands 2>/dev/null)"}} )

  (( $#std ))  && { _describe -t openssl-commands 'openssl parancs'  std  && ret=0 }
  (( $#dgst )) && { _describe -t openssl-digests  'hash parancs'     dgst && ret=0 }
  (( $#ciph )) && { _describe -t openssl-ciphers  'cipher parancs'   ciph && ret=0 }

  return ret
}

_openssl_command_options() {
  local sub=$1
  local -a opts

  [[ -n $sub ]] || return 1

  opts=( ${(f)"$(_call_program openssl-options openssl $sub -help 2>&1 | awk '
    $1 ~ /^-/ && $1 != "-*" {
      opt = $1; $1 = ""
      sub(/^[ \t]+/, "")
      if (match($0, /^(val|int|\+int|infile|outfile|format|dir|uri|nonneg|intmax|arg)([ \t]+|$)/)) {
        ph = substr($0, 1, RLENGTH); sub(/[ \t]+$/, "", ph)
        sub(/^[^ \t]+[ \t]*/, "")
        $0 = "<" ph "> " $0
      }
      gsub(/:/, " ")
      print opt ":" $0
    }')"} )

  opts=( ${(u)opts} )

  if (( $#opts )); then
    _describe -t openssl-options "$sub kapcsolo" opts
  else
    _default
  fi
}

_openssl() {
  local curcontext="$curcontext" state line ret=1
  local -a expl
  typeset -A opt_args

  _arguments -C \
    '1: :->command' \
    '*:: :->args' && ret=0

  case $state in
    command)
      _openssl_commands && ret=0
      ;;

    args)
      case ${words[CURRENT-1]} in
        -CApath|-capath|-certdir|-outdir)
          _directories && ret=0
          ;;

        -in|-out|-keyout|-inkey|-signkey|-cert|-certfile|-key|-CAfile|-CAkey|\
        -CAserial|-config|-extfile|-sigfile|-untrusted|-trusted|-CRLfile|\
        -verify|-dhparam|-paramfile|-rand|-writerand|-oid|-spkac|-ss_cert|\
        -infiles|-content|-recip|-signer|-kbfile)
          _files && ret=0
          ;;

        -passin|-passout|-passphrase)
          _wanted pass-sources expl 'jelszo forrasa' \
            compadd -S '' -- pass: env: file: fd: stdin && ret=0
          ;;

        -inform|-outform|-keyform|-certform|-CAform|-CAkeyform)
          _wanted formats expl 'formatum' compadd -- PEM DER && ret=0
          ;;

        -digest|-md|-macopt|-sigopt)
          if [[ ${words[CURRENT-1]} == (-digest|-md) ]]; then
            local -a digests
            digests=( ${=${(f)"$(_call_program openssl-digests openssl list -digest-commands 2>/dev/null)"}} )
            _wanted digests expl 'hash algoritmus' compadd -a digests && ret=0
          else
            _default && ret=0
          fi
          ;;

        *)
          _openssl_command_options ${words[1]} && ret=0
          ;;
      esac
      ;;
  esac

  return ret
}

_openssl "$@"
